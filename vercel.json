{
  "version": 2,
  "buildCommand": "cd apps/api && pnpm prisma generate && pnpm build",
  "builds": [
    { "src": "apps/api/dist/serverless.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/", "dest": "apps/api/dist/serverless.js" },
    { "src": "/api/(.*)", "dest": "apps/api/dist/serverless.js" }
  ]
}
