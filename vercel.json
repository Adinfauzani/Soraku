{
  "version": 2,
  "buildCommand": "cd apps/api && pnpm prisma generate",
  "builds": [
    { "src": "apps/api/src/serverless.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/", "dest": "apps/api/src/serverless.ts" },
    { "src": "/api/(.*)", "dest": "apps/api/src/serverless.ts" }
  ]
}
