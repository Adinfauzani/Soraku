{
  "name": "@soraku/desktop",
  "version": "0.1.0",
  "description": "Soraku desktop app - torrent streaming anime client (Windows/Linux)",
  "main": "./out/main/index.js",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build": "electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "build:linux:dir": "npm run build && electron-builder --linux dir"
  },
"devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/fuses": "^2.1.3",
    "@soraku/native": "workspace:*",
    "@soraku/torrent-client": "workspace:*",
    "@types/node": "^26.1.2",
    "abslink": "^1.2.2",
    "electron": "^42.2.0",
    "electron-builder": "^26.11.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "eslint-config-standard-universal": "^1.0.10",
    "typescript": "^6.0.3",
    "vite": "^7.3.2"
  }
}