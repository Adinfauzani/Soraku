// apps/api/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  email        String     @unique
  avatar       String?
  role         UserRole   @default(USER)
  passwordHash String?
  isPremium    Boolean    @default(false)
  premiumUntil DateTime?
  bannedAt     DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  subscriptions  Subscription[]
  watchHistory   WatchHistory[]
  favorites      Favorite[]
  watchlist      Watchlist[]
  comments       Comment[]
  ratings        Rating[]
  notifications  Notification[]

  @@map("users")
}

model AnimeMapping {
  id            String   @id @default(cuid())
  anilistId     Int      @unique

  consumetId    String?
  otakudesuId   String?
  oploverzId    String?
  hianimeId     String?
  animekaiId    String?
  kuramanimeId  String?
  anoboyId      String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("anime_mappings")
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  anilistId Int
  type      String   // NEW_EPISODE, RELEASE_REMINDER
  createdAt DateTime @default(now())

  @@unique([userId, anilistId, type])
  @@index([userId])
  @@map("subscriptions")
}

model WatchHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  anilistId Int
  episode   Int
  progress  Float    @default(0.0)
  completed Boolean  @default(false)
  watchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, anilistId, episode])
  @@index([userId, updatedAt])
  @@map("watch_history")
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  anilistId Int
  status    String   @default("PLANNING") // WATCHING, COMPLETED, PLANNING, DROPPED, ON_HOLD
  progress  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, anilistId])
  @@index([userId, status])
  @@map("watchlist")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  anilistId Int
  createdAt DateTime @default(now())

  @@unique([userId, anilistId])
  @@index([userId, createdAt])
  @@map("favorites")
}

model Rating {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  anilistId Int
  score     Int      // 1-10
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, anilistId])
  @@map("ratings")
}

model Comment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  anilistId Int
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([anilistId])
  @@map("comments")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // NEW_EPISODE, RELEASE_REMINDER, COMMENT_REPLY, SYSTEM
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}
